# ---------------------------------------------------------------------------
# Configuração do Firebase (console do Firebase > Configurações do projeto)
# Estas variáveis são embutidas no bundle no momento do build (Expo), por isso
# usam o prefixo EXPO_PUBLIC_. Os valores do Firebase Web SDK NÃO são segredos:
# eles identificam o projeto, e a proteção real vem das regras do Firestore.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBb4uCzKg79hN1eRs-jc_W9lEEEFOvjpp0
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ifinancas-35a8b.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ifinancas-35a8b
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ifinancas-35a8b.firebasestorage.app
EXPO_PUBLIC_FIREBASE_SENDER_ID=370591678468
EXPO_PUBLIC_FIREBASE_APP_ID=1:370591678468:web:0258cf6b8cad5897f0b551

# Client ID do tipo "Web" do Google (client_id com client_type 3, presente no
# google-services.json). É ele que faz o login devolver o idToken.
# Sem este valor, o GoogleSignin.signIn() funciona, mas devolve idToken=null e o
# app falha com "O Google não devolveu o idToken".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=370591678468-poqqrsgpg17lfh3fmf8f5lbjjgfv941h.apps.googleusercontent.com
